{
  "manifest_version": 2,
  "module_id": "org.3mm.store",
  "name": "3mm Store",
  "version": "0.1.0-dev.8",
  "description": "Store Application Extension for the 3mm platform.",
  "runtimes": [
    "core",
    "ui"
  ],
  "entrypoints": {
    "core": "application-extension.json",
    "ui": "compiled-ui.json"
  },
  "compatibility": {
    "protocol": "1.0",
    "core": ">=0.3.0",
    "architectures": [
      "any"
    ]
  },
  "capabilities": {
    "provides": [],
    "consumes": []
  },
  "permissions": [
    "data.read",
    "data.write",
    "process.spawn"
  ],
  "dependencies": {},
  "conflicts": [],
  "configuration_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "configuration_defaults": {},
  "registrations": [],
  "health_check": {
    "type": "json_file",
    "path": "application-extension.json"
  }
}
